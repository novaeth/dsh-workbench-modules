{
  "name": "@dsh-workbench/module-creator-daily",
  "version": "0.3.1",
  "description": "内容日更模块：今日选题、笔记数据与存草稿",
  "type": "module",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./client.js"
  },
  "files": [
    "dist",
    "client.js",
    "DEVELOPING.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "dsh-wb-module build",
    "typecheck": "tsc --noEmit",
    "selfcheck": "dsh-wb-module build && node scripts/smoke.mjs",
    "test": "vitest run --testTimeout=20000",
    "check": "dsh-wb-module check",
    "prepack": "dsh-wb-module build"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@dsh-workbench/core"
      ],
      "external": [
        "@dsh-workbench/core/client"
      ]
    },
    "workbench": {
      "apiVersion": 3,
      "unit": "creator-daily",
      "title": {
        "zh": "内容日更",
        "en": "Creator daily"
      },
      "card": {
        "order": 90
      },
      "tools": [
        {
          "name": "creator-daily_topics",
          "writes": false,
          "key": "topics"
        },
        {
          "name": "creator-daily_notes",
          "writes": false,
          "key": "notes"
        },
        {
          "name": "creator-daily_save_draft",
          "writes": true,
          "key": "saveDraft"
        }
      ],
      "host": {
        "inject": [],
        "optional": [
          "tools"
        ]
      },
      "needs": [
        {
          "kind": "bin",
          "name": "opencli",
          "purpose": "在机器上跑平台命令"
        },
        {
          "kind": "extension",
          "runtime": "opencli",
          "name": "zhihu",
          "commands": [
            "hot"
          ],
          "purpose": "知乎热榜",
          "sources": [
            {
              "kind": "builtin"
            }
          ]
        },
        {
          "kind": "extension",
          "runtime": "opencli",
          "name": "weibo",
          "commands": [
            "hot"
          ],
          "purpose": "微博热搜",
          "sources": [
            {
              "kind": "builtin"
            }
          ]
        },
        {
          "kind": "extension",
          "runtime": "opencli",
          "name": "bilibili",
          "commands": [
            "hot"
          ],
          "purpose": "B 站热门",
          "sources": [
            {
              "kind": "builtin"
            }
          ]
        },
        {
          "kind": "extension",
          "runtime": "opencli",
          "name": "xiaohongshu",
          "commands": [
            "creator-stats",
            "creator-notes",
            "publish"
          ],
          "purpose": "小红书创作者数据与草稿",
          "sources": [
            {
              "kind": "builtin"
            }
          ]
        }
      ]
    },
    "workbenchFaces": {
      "host": "src/host.ts",
      "client": "src/client.tsx"
    }
  },
  "peerDependencies": {
    "@dsh-workbench/core": "^1.5.2-rc.1",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dsh-workbench/core": "1.5.2-rc.1",
    "@dsh-workbench/module-tools": "1.5.2-rc.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "typescript": "5.9",
    "vitest": "5.0.2",
    "vite": "8.3.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novaeth/dsh-workbench-modules.git",
    "directory": "modules/creator-daily"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dsh-workbench/shared": "1.5.2-rc.1"
  }
}
